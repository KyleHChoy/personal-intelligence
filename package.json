{
  "name": "personal-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:slow": "vitest run --config vitest.slow.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "pi": "node apps/pi/src/main.ts",
    "gen:kinds": "node tools/kinds/generate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "@intelligence/contracts": "workspace:*"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
