{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**",
      "tests/**",
      "!**/dist",
      "!pnpm-lock.yaml",
      "!**/*.generated.ts",
      "!**/*.md",
      "!**/*.css",
      "!tools/clones/fixtures",
      "!tools/clones/baseline.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "preset": "recommended",
      "complexity": {
        "useMathMinMax": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
