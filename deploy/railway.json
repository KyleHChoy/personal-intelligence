{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile",
    "watchPatterns": [
      "personal/**",
      "apps/**",
      "packages/**",
      "deploy/**",
      "db/**",
      "ontology/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig*.json",
      "zones.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["/usr/local/lib/pi/predeploy"],
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 1800,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
