#!/bin/sh
# One proposal wake: started by `pi extract wake`, as pi, from an empty
# environment, after a burst of agent proposals or owner answers committed. It starts nothing
# unless every gate of the timer's extract holds: /run/pi/extract.env and /data/extract-on exist,
# and neither /data/sync-hold nor /data/read-hold does; nor while /data/wake-off exists, the
# owner's switch for the wake alone. Then the writer's intake of agent records
# (`pi-sync sync --records`, under the sync lock) and an extraction run of agent records alone
# (`pi-extract extract --agent-records`), each with its own role's file, as the timer runs them,
# and each logging to the timer's file for it, after a time line of its own.
#
# The wake yields to the timer: when no timer run has held the extract lock within
# eleven minutes, the tick's interval and a minute more, a timer run is due, so the wake takes the
# records in and leaves their run to it. The timer marks each run that held the lock by touching
# /data/pi/extract-full-at.
#
# Its exit status is the listener's code: 0 ran, 3 held, 4 the intake failed (the run still ran),
# 5 yielded to the timer, 75 the sync or an extraction run already held its lock, so the listener
# tries again; any other is the extraction's own.
#
# Each runs under the timer's time limit for it, the intake 15 minutes and the
# run 30, killed 30 seconds after the TERM; an intake its limit stopped is a failed intake (4), and
# a run its limit stopped exits with timeout's 124, or 137 after the KILL. Its two
# time lines carry `at` and `level`, as every fixed line of the box does.
set -u
PATH=/usr/local/bin:/usr/bin:/bin
umask 077
cd / || exit 1
[ -e /run/pi/extract.env ] && [ -e /data/extract-on ] && [ ! -e /data/sync-hold ] && [ ! -e /data/read-hold ] && [ ! -e /data/wake-off ] || exit 3
at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '{"event":"sync_wake_run","at":"%s","level":"info"}\n' "$at" >> /data/pi/sync.log
synced=$(/usr/bin/timeout -k 30 900 /usr/local/bin/pi-sync sync --records 2>> /data/pi/sync.log)
taken=$?
[ -n "$(find /data/pi/extract-full-at -mmin -11 2> /dev/null)" ] || exit 5
printf '{"event":"extract_wake_run","at":"%s","level":"info"}\n' "$at" >> /data/pi/extract.log
ran_out=$(/usr/bin/timeout -k 30 1800 /usr/local/bin/pi-extract extract --agent-records 2>> /data/pi/extract.log)
ran=$?
[ "$ran_out" != busy ] && [ "$synced" != busy ] || exit 75
[ "$ran" -eq 0 ] || exit "$ran"
[ "$taken" -eq 0 ] || exit 4
exit 0
